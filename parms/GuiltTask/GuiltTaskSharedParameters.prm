Application matrix StimuliMatrix= { Sender ImageReceiver } 2 3 3 4 4 // Stimuli information matrix
Application:Stimuli intlist Stimuli= 6 ../tasks/GuiltTask/stimuli/RandomDot1.bmp ../tasks/GuiltTask/stimuli/RandomDot2.bmp ../tasks/GuiltTask/stimuli/RandomDot3.bmp ../tasks/GuiltTask/stimuli/RandomDot4.bmp ../tasks/GuiltTask/stimuli/RandomDot5.bmp ../tasks/GuiltTask/stimuli/RandomDot6.bmp %% %% %% // Path of the dots images
Application:Stimuli intlist MyStimuliSequence= 6 1 2 3 4 5 6 %% 1 64 // Sequence of the dots image.
Application:Stimuli intlist StimuliSequencePractice= 4 2 4 6 8 %% 1 64 // Practice sequence of the dots image.
Application:Experiment intlist InstructionPathTrans= 9 ../tasks/GuiltTask/instructs/transgressor/transgressor1.png ../tasks/GuiltTask/instructs/transgressor/transgressor2.png ../tasks/GuiltTask/instructs/transgressor/transgressor3.png ../tasks/GuiltTask/instructs/transgressor/transgressor4.png ../tasks/GuiltTask/instructs/transgressor/transgressor5.png ../tasks/GuiltTask/instructs/transgressor/transgressor6.png ../tasks/GuiltTask/instructs/transgressor/transgressor7.png ../tasks/GuiltTask/instructs/transgressor/transgressor8.png ../tasks/GuiltTask/instructs/transgressor/transgressor9.png %% %% %% // Instruction images path for the transgressor
Application:Experiment intlist InstructionPathVicT= 9 ../tasks/GuiltTask/instructs/victim/victim1.png ../tasks/GuiltTask/instructs/victim/victim2.png ../tasks/GuiltTask/instructs/victim/victim3.png ../tasks/GuiltTask/instructs/victim/victim4.png ../tasks/GuiltTask/instructs/victim/victim5.png ../tasks/GuiltTask/instructs/victim/victim6.png ../tasks/GuiltTask/instructs/victim/victim7.png ../tasks/GuiltTask/instructs/victim/victim8.png ../tasks/GuiltTask/instructs/victim/victim9.png %% %% %% // Instruction images path for the victim
Application:Experiment intlist FeedbackPathList= 7 ../tasks/GuiltTask/feedback/victim_you_incorrect.png ../tasks/GuiltTask/feedback/victim_you_correct.png ../tasks/GuiltTask/feedback/victim_both_incorrect.png ../tasks/GuiltTask/feedback/trans_you_incorrect.png ../tasks/GuiltTask/feedback/trans_you_correct.png ../tasks/GuiltTask/feedback/trans_both_incorrect.png ../tasks/GuiltTask/feedback/both_correct.png %% %% %% // Feedback images path list
Application:Experiment intlist TrialSequence1= 6 2 1 4 2 3 2 %% %% %% // Sequence of the trial type.
Application:Experiment intlist TrialSequence2= 6 3 1 4 2 3 3 %% %% %% // Sequence of the trial type.
Application:Experiment intlist FixationDurationList= 6 3000 2000 3000 2000 1000 2000 %% %% %% // Duration of Fixation(ITI)
Application:Experiment intlist GuessNumberList= 6 21 20 19 20 20 19 %% %% %% // Guess number list
Application:Experiment float DotsDuration= 1500ms 1500ms 0 %% // Duration of dots
Application:Experiment float ResponseDuration= 3000ms 3000ms 0 %% // Time allows the subject to make a response
Application:Experiment float OutcomeDuration= 3000ms 3000ms 0 %% // Duration to display the outcome
Application:Experiment float CompensationOutcomeDuration= 3000ms 5000ms 0 %% // Duration to display the outcome
Application:Experiment float CompensationDuration= 5000ms 5000ms 0 %% // Duration of the compensation/forgiveness phase
Application:Experiment int EnablePractice= 1 1 0 1 // Enable the practice trials
Application:Experiment int StartPoints= 30 30 0 % // The starting points.
Application:Experiment string GuessDots= Is%20the%20number%20of%20dots%20greater%20or%20less%20than: // Guess the number of dots text
Application:Experiment string optionOne= Greater // Guess option one
Application:Experiment string optionTwo= Less // Guess option one
Application:Experiment string CompensationQuestion= How%20many%20points%20would%20you%20be%20willing%20to%20transfer%20to%20Player%20B%20as%20compensation?%0d%0aPlease%20Complete%20your%20selection%20within%205%20seconds,%20then%20press%20SPACE%20to%20continue. // Compensation question
Application:Experiment stringlist CompensationList= 6 0%20point 1%20point 2%20points 3%20points 4%20points 5%20points %% %% %% // Compensation options
Application:Experiment string ForgivenessQuestion= How%20many%20points%20would%20you%20like%20to%20request%20from%20Player%20A%20as%20compensation?%0d%0aPlease%20Complete%20your%20selection%20within%205%20seconds,%20then%20press%20SPACE%20to%20continue. // Forgiveness question
